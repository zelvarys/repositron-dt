{
  "name": "repositron",
  "version": "1.0.1",
  "description": "Interactive terminal dashboard that scans GitHub repositories and surfaces activity, dependencies, workflow health, bus factor, and tool adoption",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zelvarys/repositron-dt.git"
  },
  "type": "module",
  "bin": {
    "repositron": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "tui",
    "github",
    "repository",
    "insights",
    "ink"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "dev": "node --import tsx src/cli.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "conf": "^16.0.0",
    "ink": "^8.0.0",
    "ink-link": "^5.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^14.1.0",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
